<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless, cross-platform MCP server for Agrus Scanner.
    Shares the scanning engine and MCP tools with the WPF app via linked sources, so the
    desktop app and this container/CLI build expose byte-for-byte the same tool surface.
    Default transport is stdio (what MCP clients and Glama expect); pass the http flag (see Program.cs) for
    Streamable HTTP.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>agrus-mcp</AssemblyName>
    <RootNamespace>AgrusScanner.McpServer</RootNamespace>
    <Version>1.0.3</Version>
    <Product>Agrus Scanner MCP Server</Product>
    <Description>Network reconnaissance and AI/MCP service discovery as MCP tools</Description>
    <Copyright>Copyright (c) 2025 Agrus</Copyright>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared engine, models, and tool definitions, linked from the desktop app. -->
    <Compile Include="..\AgrusScanner\Services\*.cs" Link="Shared\Services\%(Filename)%(Extension)" />
    <Compile Include="..\AgrusScanner\Models\*.cs" Link="Shared\Models\%(Filename)%(Extension)" />
    <Compile Include="..\AgrusScanner\Mcp\ScannerMcpTools.cs" Link="Shared\Mcp\ScannerMcpTools.cs" />
    <!-- SignatureStore loads this by LogicalName from the executing assembly, so embed it here too. -->
    <EmbeddedResource Include="..\signatures\catalog.json" LogicalName="AgrusScanner.signatures.catalog.json" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" Version="0.9.0-preview.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.9.0-preview.2" />
  </ItemGroup>

</Project>
