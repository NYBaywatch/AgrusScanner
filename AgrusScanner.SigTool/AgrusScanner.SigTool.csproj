<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgrusScanner.SigTool</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared envelope + catalog model, linked from the app so both sides agree byte-for-byte. -->
    <Compile Include="..\AgrusScanner\Services\SignaturePackage.cs" Link="Shared\SignaturePackage.cs" />
    <Compile Include="..\AgrusScanner\Models\SignatureCatalog.cs" Link="Shared\SignatureCatalog.cs" />
    <Compile Include="..\AgrusScanner\Models\ProbeDefinition.cs" Link="Shared\ProbeDefinition.cs" />
  </ItemGroup>

</Project>
